# FoodIQ Mobile Environment Configuration Template
# NOTE: Values bundled into mobile applications are client-accessible and must NEVER contain
# server private keys, payment gateway secret keys, or database passwords.

# Backend REST API Base URL
# For Android Emulator connecting to local Spring Boot: http://10.0.2.2:8080/api
# For iOS Simulator connecting to local Spring Boot: http://localhost:8080/api
# For Production Cloud Backend: https://deliveryapp-wwx8.onrender.com/api
API_BASE_URL=https://deliveryapp-wwx8.onrender.com/api

# WebSocket STOMP Endpoint
# Local: ws://10.0.2.2:8080/api/ws/websocket
# Production: wss://deliveryapp-wwx8.onrender.com/api/ws/websocket
WEBSOCKET_URL=wss://deliveryapp-wwx8.onrender.com/api/ws/websocket

# Environment Name: development, staging, production
ENVIRONMENT=production

# App Timeout Thresholds in Milliseconds
CONNECT_TIMEOUT=20000
RECEIVE_TIMEOUT=25000
